# Copy this file to .env and replace every placeholder with real SMTP credentials.
# Never prefix SMTP secrets with VITE_: VITE_ variables are exposed to browser code.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Zexton Website <no-reply@zexton.com>"
CONTACT_TO_EMAIL=info@zexton.com
CONTACT_ALLOWED_ORIGINS=https://zexton.com,http://localhost:5173
PORT=4173
